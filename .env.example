# Copie para .env.local (para rodar no seu computador) ou cadastre na Vercel
# em Settings > Environment Variables. No Supabase: a URL está no botão Connect;
# a chave Publishable (sb_publishable_...) está em Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Entrega 3 · API de ponto (URL e token da API de demonstração, ou do seu fornecedor)
PONTO_API_URL=https://api-ponto-demo.vercel.app
PONTO_API_TOKEN=DEMO-AULAO-2026
